{
  "projectName": "gomoku",
  "language": "python",
  "include": [
    "main.py",
    "gomoku/*.py"
  ],
  "exclude": [
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/.git/**",
    "**/.venv/**",
    "**/venv/**",
    "tests/**"
  ],
  "entrypoints": [
    "gomoku.cli:main"
  ],
  "executionEntrypoints": [
    "gomoku.cli:GameCli.run"
  ],
  "modules": [
    {
      "id": "terminal",
      "name": "终端入口与交互",
      "include": [
        "main.py",
        "gomoku/__init__.py",
        "gomoku/__main__.py",
        "gomoku/cli.py"
      ],
      "note": "脚本入口、python -m 入口与终端主菜单/对局交互入口；入口与流程编排由 executionOnlyCallables 表达。",
      "color": "#f59e0b",
      "role": "component",
      "executionOnlyCallables": [
        "gomoku.cli:GameCli.run"
      ],
      "defaultFreeFunctionSurface": "internal"
    },
    {
      "id": "terminal-ui",
      "name": "终端交互组件",
      "include": [
        "gomoku/input_parser.py",
        "gomoku/renderer.py"
      ],
      "note": "输入解析、坐标格式化和终端棋盘渲染组件；自由辅助函数均为模块内部实现。",
      "color": "#fb7185",
      "role": "component",
      "defaultFreeFunctionSurface": "internal"
    },
    {
      "id": "application",
      "name": "对局应用层",
      "include": [
        "gomoku/game.py",
        "gomoku/config.py"
      ],
      "note": "组织完整对局用例、执子方推进、终局判定与对局配置。",
      "color": "#60a5fa",
      "role": "service"
    },
    {
      "id": "domain",
      "name": "棋盘领域模型",
      "include": [
        "gomoku/board.py",
        "gomoku/models.py"
      ],
      "note": "棋盘状态与胜负判定事实来源，以及坐标、棋子、落子结果和错误契约。",
      "color": "#22d3ee",
      "role": "service"
    },
    {
      "id": "ai-adapter",
      "name": "电脑对手适配器",
      "include": [
        "gomoku/ai.py"
      ],
      "note": "本地启发式电脑落点选择适配器，通过 MoveSelector 协议接入对局用例。",
      "color": "#a78bfa",
      "role": "adapter"
    }
  ],
  "dispatchHints": [],
  "contract": {
    "providerRoles": {
      "gomoku.cli.GameCli": "component",
      "gomoku.input_parser.ParsedCommand": "model",
      "gomoku.renderer.BoardRenderer": "component",
      "gomoku.game.GomokuGame": "manager",
      "gomoku.game.MoveSelector": "contract",
      "gomoku.game.TurnOutcome": "model",
      "gomoku.config.GameConfig": "config",
      "gomoku.board.Board": "manager",
      "gomoku.models.Stone": "config",
      "gomoku.models.Position": "model",
      "gomoku.models.MoveResult": "model",
      "gomoku.models.ValidationError": "model",
      "gomoku.ai.SimpleAiPlayer": "adapter"
    }
  },
  "flowScopes": {
    "enabled": true,
    "roots": [
      "gomoku.cli:GameCli._play_one_game"
    ],
    "maxScopesPerFlow": 6,
    "maxNodesPerScope": 24,
    "maxEdgesPerScope": 32
  }
}
