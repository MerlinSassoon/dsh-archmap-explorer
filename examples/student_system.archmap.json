{
  "projectName": "student_system",
  "language": "python",
  "include": [
    "*.py"
  ],
  "exclude": [
    "**/__pycache__/**"
  ],
  "entrypoints": [
    "main:server",
    "main:client",
    "main"
  ],
  "modules": [
    {
      "id": "entry-network",
      "name": "入口与网络",
      "include": [
        "main.py",
        "TcpConnect.py"
      ],
      "note": "程序启动、角色选择、TCP 连接与客户端/服务端主循环。",
      "color": "#f59e0b",
      "role": "main",
      "kind": "main"
    },
    {
      "id": "menu",
      "name": "菜单与交互",
      "include": [
        "menu_system.py"
      ],
      "note": "终端菜单、键盘事件与学生信息管理功能编排。",
      "color": "#60a5fa",
      "role": "service",
      "kind": "functional"
    },
    {
      "id": "database",
      "name": "数据访问",
      "include": [
        "database.py"
      ],
      "note": "MySQL 连接、协议解码以及学生数据增删改查。",
      "color": "#8bdc64",
      "role": "service",
      "kind": "functional"
    },
    {
      "id": "async",
      "name": "异步等待",
      "include": [
        "thread_waiting.py"
      ],
      "note": "后台线程动画与等待反馈。",
      "color": "#a78bfa",
      "role": "service",
      "kind": "functional"
    },
    {
      "id": "misc",
      "name": "测试脚本",
      "include": [
        "测试.py"
      ],
      "note": "独立的学生表格打印验证脚本。",
      "color": "#f472b6",
      "role": "test",
      "kind": "functional"
    }
  ],
  "mainModule": "entry-network"
}
