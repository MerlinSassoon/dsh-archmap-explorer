{
  "projectName": "archmap_v3",
  "language": "python",
  "include": [
    "archmap/**/*.py"
  ],
  "exclude": [
    "**/__pycache__/**"
  ],
  "entrypoints": [
    "archmap.entry.cli_entry:main"
  ],
  "modules": [
    {
      "id": "pipeline",
      "name": "流水线",
      "include": [
        "archmap/__init__.py",
        "archmap/__main__.py",
        "archmap/entry/*.py",
        "archmap/managers/__init__.py",
        "archmap/managers/pipeline_manager.py",
        "archmap/utility/__init__.py",
        "archmap/utility/pipeline_utility.py",
        "archmap/utility/cli_utility.py",
        "archmap/config/__init__.py",
        "archmap/config/project_config.py",
        "archmap/config/contract_config.py",
        "archmap/utility/config_utility.py"
      ],
      "note": "CLI 入口、配置加载、流水线编排与模块配置模型。",
      "color": "#f59e0b",
      "role": "service",
      "executionOnlyCallables": [
        "archmap.entry.cli_entry:main"
      ],
      "defaultFreeFunctionSurface": "internal"
    },
    {
      "id": "python-frontend",
      "name": "Python 前端",
      "include": [
        "archmap/frontends/*.py",
        "archmap/frontends/**/*.py",
        "archmap/managers/frontend_manager.py",
        "archmap/utility/analysis_utility.py",
        "archmap/utility/call_utility.py",
        "archmap/utility/detail_utility.py",
        "archmap/utility/contract_utility.py",
        "archmap/utility/role_utility.py",
        "archmap/utility/discovery_utility.py",
        "archmap/config/detail_config.py",
        "archmap/model/__init__.py",
        "archmap/model/analysis_model.py",
        "archmap/model/call_model.py",
        "archmap/model/contract_model.py",
        "archmap/model/frontend_contract.py"
      ],
      "note": "Python 源码发现、AST 分析、调用解析、契约与 Provider Role 投影。",
      "color": "#60a5fa",
      "role": "service"
    },
    {
      "id": "graph-projection",
      "name": "图投影与查询",
      "include": [
        "archmap/managers/graph_manager.py",
        "archmap/utility/graph_utility.py",
        "archmap/utility/call_resolution_utility.py",
        "archmap/utility/execution_flow_utility.py",
        "archmap/utility/execution_layout_utility.py",
        "archmap/utility/query_utility.py",
        "archmap/config/graph_config.py",
        "archmap/model/execution_model.py",
        "archmap/model/graph_model.py"
      ],
      "note": "三层 bundle、执行流、共享调用解析、布局、指纹与影响查询。",
      "color": "#a78bfa",
      "role": "service"
    },
    {
      "id": "validation",
      "name": "校验",
      "include": [
        "archmap/managers/validate_manager.py",
        "archmap/utility/validate_utility.py"
      ],
      "note": "schema 5.0、交叉引用和执行流不变量校验。",
      "color": "#22d3ee",
      "role": "service"
    },
    {
      "id": "rendering",
      "name": "自包含渲染",
      "include": [
        "archmap/managers/render_manager.py",
        "archmap/utility/render_utility.py"
      ],
      "note": "RenderManager 门面与自包含 HTML 渲染、前端资源和交互视图。",
      "color": "#8bdc64",
      "role": "service"
    }
  ],
  "dispatchHints": [
    {
      "function": "archmap.entry.cli_entry:main",
      "expression": "args.func",
      "occurrence": 1,
      "candidates": [
        "archmap.utility.cli_utility:cmd_build",
        "archmap.utility.cli_utility:cmd_check",
        "archmap.utility.cli_utility:cmd_method",
        "archmap.utility.cli_utility:cmd_serve",
        "archmap.utility.cli_utility:cmd_diff",
        "archmap.utility.cli_utility:cmd_impact",
        "archmap.utility.cli_utility:cmd_trace",
        "archmap.utility.cli_utility:cmd_surfaces",
        "archmap.utility.cli_utility:cmd_dsm"
      ],
      "complete": true,
      "reason": "argparse_dispatch"
    }
  ]
}
