{
  "projectName": "archmap_v3",
  "language": "python",
  "include": [
    "archmap/**/*.py"
  ],
  "exclude": [
    "**/__pycache__/**",
    "archmap/analysis.py",
    "archmap/callresolver.py",
    "archmap/callsites.py",
    "archmap/cli.py",
    "archmap/config.py",
    "archmap/contracts.py",
    "archmap/details.py",
    "archmap/discover.py",
    "archmap/graph.py",
    "archmap/pipeline.py",
    "archmap/render.py",
    "archmap/validate.py",
    "archmap/frontends/base.py",
    "archmap/frontends/registry.py",
    "archmap/frontends/python/capabilities.py",
    "archmap/frontends/python/roles.py"
  ],
  "project": {
    "inputs": [
      "Python 项目路径与 archmap 配置"
    ],
    "outputs": [
      "architecture.json",
      "architecture.html"
    ]
  },
  "entrypoints": [
    "archmap.entry.cli_entry:main"
  ],
  "modules": [
    {
      "id": "entry-pipeline",
      "name": "入口与流水线",
      "include": [
        "archmap/__init__.py",
        "archmap/__main__.py",
        "archmap/entry/*.py",
        "archmap/managers/__init__.py",
        "archmap/managers/pipeline_manager.py",
        "archmap/utility/__init__.py",
        "archmap/utility/cli_utility.py",
        "archmap/utility/pipeline_utility.py"
      ],
      "note": "CLI 入口、应用级流水线编排与 CLI 内部命令处理。",
      "inputs": [
        "命令行参数与项目配置"
      ],
      "outputs": [
        "分析任务与构建产物"
      ],
      "color": "#f59e0b",
      "role": "main"
    },
    {
      "id": "config-model",
      "name": "配置与模型",
      "include": [
        "archmap/config/*.py",
        "archmap/model/*.py",
        "archmap/utility/config_utility.py"
      ],
      "note": "静态配置、常量、运行期数据模型、契约模型与配置加载工具。",
      "inputs": [
        "JSON 配置与扫描参数"
      ],
      "outputs": [
        "ProjectConfig、AnalysisResult、CallSite 与 API 契约模型"
      ],
      "color": "#22d3ee",
      "role": "service"
    },
    {
      "id": "python-frontend",
      "name": "Python 前端",
      "include": [
        "archmap/frontends/*.py",
        "archmap/frontends/**/*.py",
        "archmap/managers/frontend_manager.py",
        "archmap/utility/analysis_utility.py",
        "archmap/utility/call_utility.py",
        "archmap/utility/detail_utility.py",
        "archmap/utility/contract_utility.py",
        "archmap/utility/role_utility.py",
        "archmap/utility/discovery_utility.py"
      ],
      "note": "PythonFrontend 统一门面及其发现、分析、调用、详情、角色与契约内部工具。",
      "inputs": [
        "Python 源码与扫描配置"
      ],
      "outputs": [
        "模块、函数、调用目标、函数详情与 canonical 契约"
      ],
      "color": "#60a5fa",
      "role": "service"
    },
    {
      "id": "graph-projection",
      "name": "架构投影",
      "include": [
        "archmap/managers/graph_manager.py",
        "archmap/utility/graph_utility.py"
      ],
      "note": "GraphManager 门面及其三层投影、布局与指纹内部工具。",
      "inputs": [
        "函数详情、调用记录与逻辑模块配置"
      ],
      "outputs": [
        "archmap.bundle 与三层架构投影"
      ],
      "color": "#a78bfa",
      "role": "service"
    },
    {
      "id": "validate-render",
      "name": "校验与渲染",
      "include": [
        "archmap/managers/validate_manager.py",
        "archmap/managers/render_manager.py",
        "archmap/utility/validate_utility.py",
        "archmap/utility/render_utility.py"
      ],
      "note": "ValidationManager / RenderManager 门面及校验、自包含 HTML 渲染内部工具。",
      "inputs": [
        "bundle、layout 与可选 LLM 注解"
      ],
      "outputs": [
        "校验报告与单文件 architecture.html"
      ],
      "color": "#f472b6",
      "role": "service"
    }
  ]
}
