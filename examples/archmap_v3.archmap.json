{
  "projectName": "archmap_v3",
  "language": "python",
  "include": [
    "archmap/**/*.py"
  ],
  "exclude": [
    "**/__pycache__/**"
  ],
  "project": {
    "inputs": [
      "Python 项目路径与 archmap 配置"
    ],
    "outputs": [
      "architecture.json",
      "architecture.html"
    ]
  },
  "entrypoints": [
    "archmap.cli:main"
  ],
  "modules": [
    {
      "id": "cli-pipeline",
      "name": "CLI 与流水线",
      "include": [
        "archmap/__init__.py",
        "archmap/__main__.py",
        "archmap/cli.py",
        "archmap/config.py",
        "archmap/pipeline.py"
      ],
      "note": "命令行入口、配置加载与发现→分析→调用事实→详情→构建的总流水线。",
      "inputs": [
        "命令行参数与项目配置"
      ],
      "outputs": [
        "分析任务与构建产物"
      ],
      "color": "#f59e0b",
      "role": "main"
    },
    {
      "id": "python-frontend",
      "name": "Python 前端",
      "include": [
        "archmap/discover.py",
        "archmap/analysis.py",
        "archmap/callresolver.py",
        "archmap/callsites.py",
        "archmap/details.py",
        "archmap/frontends/**/*.py"
      ],
      "note": "源码发现、AST 索引、符号解析、调用解析与语言前端适配层。",
      "inputs": [
        "Python 源码与扫描配置"
      ],
      "outputs": [
        "模块、函数、调用目标与 canonical 分析结果"
      ],
      "color": "#60a5fa",
      "role": "service"
    },
    {
      "id": "graph-projection",
      "name": "架构投影",
      "include": [
        "archmap/graph.py"
      ],
      "note": "生成 ProjectGraph、ModuleGraph、模块能力契约、宏观调用/数据边、入口与语义指纹。",
      "inputs": [
        "函数详情、调用记录与逻辑模块配置"
      ],
      "outputs": [
        "archmap.bundle 与三层架构投影"
      ],
      "color": "#a78bfa",
      "role": "service"
    },
    {
      "id": "validate-render",
      "name": "校验与渲染",
      "include": [
        "archmap/validate.py",
        "archmap/render.py"
      ],
      "note": "三层 bundle 校验、跨引用检查以及自包含 HTML 模板渲染。",
      "inputs": [
        "bundle、layout 与可选 LLM 注解"
      ],
      "outputs": [
        "校验报告与单文件 architecture.html"
      ],
      "color": "#f472b6",
      "role": "service"
    }
  ]
}
