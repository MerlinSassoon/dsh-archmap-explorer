{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archmap.local/schema/archmap-v3-bundle.schema.json",
  "title": "ArchMap v3 architecture bundle",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "kind",
    "project",
    "entrypoints",
    "projectGraph",
    "moduleGraphs",
    "functionDetails",
    "callSites",
    "diagnostics",
    "stats"
  ],
  "properties": {
    "schemaVersion": {
      "const": "3.1"
    },
    "kind": {
      "const": "archmap.bundle"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entrypoint"
      }
    },
    "projectGraph": {
      "$ref": "#/$defs/projectGraph"
    },
    "moduleGraphs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/moduleGraph"
      }
    },
    "functionDetails": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/functionDetail"
      }
    },
    "callSites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/callSite"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "stats": {
      "$ref": "#/$defs/stats"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "root",
        "language",
        "generatedAt",
        "fingerprint"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "enum": [
            "python",
            "arkts"
          ]
        },
        "pythonVersion": {
          "type": "string"
        },
        "generatedAt": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "functionId",
        "reason"
      ],
      "properties": {
        "functionId": {
          "$ref": "#/$defs/identifier"
        },
        "reason": {
          "enum": [
            "main",
            "configured",
            "route",
            "heuristic"
          ]
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fromFunctionId": {
          "type": "string"
        },
        "toFunctionId": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        }
      }
    },
    "macroEdge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "from",
        "to",
        "primaryType",
        "relations",
        "role",
        "confidence",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "from": {
          "$ref": "#/$defs/identifier"
        },
        "to": {
          "$ref": "#/$defs/identifier"
        },
        "primaryType": {
          "enum": [
            "call",
            "data",
            "control"
          ]
        },
        "relations": {
          "type": "array",
          "items": {
            "enum": [
              "call",
              "data",
              "control"
            ]
          }
        },
        "role": {
          "enum": [
            "internal",
            "project_input",
            "project_output",
            "module_input",
            "module_output"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "macroNode": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "layoutNode": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "cx": {
          "type": "number"
        },
        "rank": {
          "type": "integer"
        }
      }
    },
    "layoutEdge": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "d"
      ],
      "properties": {
        "d": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "label": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "canvas",
        "nodes",
        "edges"
      ],
      "properties": {
        "canvas": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "width",
            "height",
            "padding"
          ],
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            },
            "padding": {
              "type": "number"
            }
          }
        },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/layoutNode"
          }
        },
        "edges": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/layoutEdge"
          }
        }
      }
    },
    "projectGraph": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "project",
        "boundaryNodes",
        "modules",
        "edges",
        "layout"
      ],
      "properties": {
        "kind": {
          "const": "archmap.project-graph"
        },
        "project": {
          "type": "object",
          "additionalProperties": true
        },
        "boundaryNodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/macroNode"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/macroNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/macroEdge"
          }
        },
        "layout": {
          "$ref": "#/$defs/layout"
        }
      }
    },
    "moduleGraph": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind",
        "moduleId",
        "name",
        "note",
        "color",
        "inputs",
        "outputs",
        "nodes",
        "edges",
        "layout"
      ],
      "properties": {
        "kind": {
          "const": "archmap.module-graph"
        },
        "moduleId": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/macroNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/macroEdge"
          }
        },
        "methodEdges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/macroEdge"
          }
        },
        "classCount": {
          "type": "integer",
          "minimum": 0
        },
        "methodCount": {
          "type": "integer",
          "minimum": 0
        },
        "layout": {
          "$ref": "#/$defs/layout"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "functionId": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        }
      }
    },
    "functionDetail": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "qualifiedName",
        "module",
        "moduleId",
        "file",
        "line",
        "endLine",
        "signature",
        "isAsync",
        "note",
        "source",
        "sourceHash",
        "callers",
        "callees"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string"
        },
        "qualifiedName": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "moduleId": {
          "$ref": "#/$defs/identifier"
        },
        "ownerClassId": {
          "type": [
            "string",
            "null"
          ]
        },
        "methodKind": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "isAbstract": {
          "type": "boolean"
        },
        "isAsync": {
          "type": "boolean"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "endLine": {
          "type": "integer"
        },
        "signature": {
          "type": "string"
        },
        "returns": {
          "type": "string"
        },
        "raises": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "text",
            "startLine",
            "endLine"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "startLine": {
              "type": "integer"
            },
            "endLine": {
              "type": "integer"
            },
            "truncated": {
              "type": "boolean"
            },
            "language": {
              "type": "string"
            }
          }
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "callers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "callees": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "callerCount": {
          "type": "integer"
        },
        "calleeCount": {
          "type": "integer"
        }
      }
    },
    "callSite": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "fromFunctionId",
        "file",
        "line",
        "column",
        "calleeText",
        "callText",
        "kind",
        "resolved",
        "external",
        "recursive",
        "confidence",
        "candidates"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "fromFunctionId": {
          "$ref": "#/$defs/identifier"
        },
        "fromModuleId": {
          "type": "string"
        },
        "toFunctionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "toModuleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "column": {
          "type": "integer"
        },
        "calleeText": {
          "type": "string"
        },
        "callText": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "resolved": {
          "type": "boolean"
        },
        "external": {
          "type": "boolean"
        },
        "recursive": {
          "type": "boolean"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "argumentCount": {
          "type": "integer"
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "modules",
        "classes",
        "functions",
        "methods",
        "callSites",
        "resolvedCalls",
        "macroEdges",
        "diagnostics"
      ],
      "properties": {
        "modules": {
          "type": "integer"
        },
        "classes": {
          "type": "integer"
        },
        "functions": {
          "type": "integer"
        },
        "methods": {
          "type": "integer"
        },
        "callSites": {
          "type": "integer"
        },
        "resolvedCalls": {
          "type": "integer"
        },
        "macroEdges": {
          "type": "integer"
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "error": {
              "type": "integer"
            },
            "warning": {
              "type": "integer"
            },
            "info": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
