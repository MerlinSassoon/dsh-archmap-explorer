{
  "projectName": "inheritance_demo",
  "language": "python",
  "include": ["app/*.py"],
  "exclude": ["**/__pycache__/**"],
  "mainModule": "main",
  "entrypoints": ["app.main:main"],
  "modules": [
    {
      "id": "main",
      "name": "主流程",
      "kind": "main",
      "include": ["app/main.py"],
      "role": "main",
      "color": "#f59e0b"
    },
    {
      "id": "base",
      "name": "类型契约",
      "kind": "functional",
      "include": ["app/base.py"],
      "role": "service",
      "color": "#60a5fa"
    },
    {
      "id": "impl",
      "name": "具体实现",
      "kind": "functional",
      "include": ["app/impl.py"],
      "role": "service",
      "color": "#22c55e"
    }
  ]
}
