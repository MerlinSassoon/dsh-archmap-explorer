{
  "projectName": "p4_demo",
  "language": "python",
  "include": [
    "app/*.py"
  ],
  "exclude": [
    "**/__pycache__/**"
  ],
  "entrypoints": [
    "app.main:main"
  ],
  "modules": [
    {
      "id": "main",
      "name": "主流程",
      "include": [
        "app/main.py"
      ],
      "role": "service",
      "color": "#f59e0b"
    },
    {
      "id": "service",
      "name": "订单服务",
      "include": [
        "app/manager.py",
        "app/repository.py"
      ],
      "role": "service",
      "color": "#60a5fa"
    },
    {
      "id": "domain",
      "name": "领域模型",
      "include": [
        "app/model.py",
        "app/cache.py"
      ],
      "role": "service",
      "color": "#22c55e"
    }
  ]
}
