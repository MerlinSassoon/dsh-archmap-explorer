{
  "projectName": "student_demo",
  "language": "python",
  "include": [
    "app/*.py"
  ],
  "exclude": [
    "**/__pycache__/**"
  ],
  "entrypoints": [
    "main:main"
  ],
  "modules": [
    {
      "id": "entry",
      "name": "入口",
      "include": [
        "app/main.py"
      ],
      "note": "程序入口模块",
      "color": "#f59e0b",
      "role": "service",
      "defaultFreeFunctionSurface": "capability"
    },
    {
      "id": "service",
      "name": "服务",
      "include": [
        "app/service.py"
      ],
      "note": "业务编排模块",
      "color": "#60a5fa",
      "role": "service",
      "defaultFreeFunctionSurface": "capability"
    },
    {
      "id": "repo",
      "name": "数据访问",
      "include": [
        "app/repo.py"
      ],
      "note": "数据读写模块",
      "color": "#8bdc64",
      "role": "service",
      "defaultFreeFunctionSurface": "capability"
    }
  ]
}
