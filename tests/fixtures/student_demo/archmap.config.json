{
  "projectName": "student_demo",
  "language": "python",
  "include": ["app/*.py"],
  "exclude": ["**/__pycache__/**"],
  "project": {
    "inputs": ["用户请求"],
    "outputs": ["处理结果"]
  },
  "entrypoints": ["main:main"],
  "modules": [
    {
      "id": "entry",
      "name": "入口",
      "include": ["app/main.py"],
      "note": "程序入口模块",
      "inputs": ["用户请求"],
      "outputs": ["处理结果"],
      "color": "#f59e0b"
    },
    {
      "id": "service",
      "name": "服务",
      "include": ["app/service.py"],
      "note": "业务编排模块",
      "inputs": ["入口参数"],
      "outputs": ["服务结果"],
      "color": "#60a5fa"
    },
    {
      "id": "repo",
      "name": "数据访问",
      "include": ["app/repo.py"],
      "note": "数据读写模块",
      "inputs": ["查询条件"],
      "outputs": ["存储结果"],
      "color": "#8bdc64"
    }
  ]
}
