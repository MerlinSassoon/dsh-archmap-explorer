{
  "projectName": "roles_demo",
  "language": "python",
  "include": [
    "app/*.py"
  ],
  "exclude": [
    "**/__pycache__/**"
  ],
  "entrypoints": [
    "app.roles:main"
  ],
  "contract": {
    "providerRoles": {
      "app.roles.ConfigOverrideThing": "model"
    }
